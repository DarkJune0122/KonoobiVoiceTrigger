<Application
    x:Class="VoiceTrigger.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:style="clr-namespace:VoiceTrigger.Styles"
    xmlns:shader="clr-namespace:VoiceTrigger.Shaders"
    xmlns:local="clr-namespace:VoiceTrigger"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <style:ThemesDictionary Theme="Dark" />
            </ResourceDictionary.MergedDictionaries>
            <local:RootViewModel x:Key="RootViewModel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
