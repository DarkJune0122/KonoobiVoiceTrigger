<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ControlPanelIconColor">#F0F003</Color>
    <SolidColorBrush x:Key="ControlPanelIconBrush" Color="{StaticResource ControlPanelIconColor}" />
    <Color x:Key="SliderThumbIconColor">#F0F003</Color>
    <SolidColorBrush x:Key="SliderThumbIconBrush" Color="{StaticResource SliderThumbIconColor}" />
    <Color x:Key="SliderThumbFillColor">#00000000</Color>
    <SolidColorBrush x:Key="SliderThumbFillBrush" Color="{StaticResource SliderThumbFillColor}" />
    
    <Color x:Key="TriggeredControlPanelIconColor">#F00003</Color>
    <SolidColorBrush x:Key="TriggeredControlPanelIconBrush" Color="{StaticResource TriggeredControlPanelIconColor}" />
    <Color x:Key="TriggeredSliderThumbIconColor">#F00003</Color>
    <SolidColorBrush x:Key="TriggeredSliderThumbIconBrush" Color="{StaticResource TriggeredSliderThumbIconColor}" />
    <Color x:Key="TriggeredSliderThumbFillColor">#00000000</Color>
    <SolidColorBrush x:Key="TriggeredSliderThumbFillBrush" Color="{StaticResource TriggeredSliderThumbFillColor}" />
    
    <Color x:Key="StyledTextColor">#F0F0F0</Color>
    <SolidColorBrush x:Key="StyledTextBrush" Color="{StaticResource StyledTextColor}" />
    
    <!--Audio color indicators-->
    <Color x:Key="GreenAudioAxisColor">#0AF000</Color>
    <SolidColorBrush x:Key="GreenAudioAxisBrush" Color="{StaticResource GreenAudioAxisColor}" />
    <Color x:Key="YellowAudioAxisColor">#A0A000</Color>
    <SolidColorBrush x:Key="YellowAudioAxisBrush" Color="{StaticResource YellowAudioAxisColor}" />
    <Color x:Key="RedAudioAxisColor">#F00404</Color>
    <SolidColorBrush x:Key="RedAudioAxisBrush" Color="{StaticResource RedAudioAxisColor}" />
</ResourceDictionary>