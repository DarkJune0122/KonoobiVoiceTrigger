        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="128" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="1" Width="128" Height="128" Fill="Gray" />
        </Grid>

        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
